# ============================================
# 英语听写练习应用 - 环境配置
# 复制此文件为 .env 并填入你的配置
# ============================================

# LongCat 网关配置（推荐）
ANTHROPIC_AUTH_TOKEN=your_longcat_auth_token_here
ANTHROPIC_BASE_URL=https://api.longcat.chat/anthropic

# LLM 模型配置
LLM_MODEL=LongCat-2.0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# Flask 密钥（请修改为随机字符串）
SECRET_KEY=your-secret-key-here

# 可选：Anthropic 官方配置（不使用 LongCat 时）
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
